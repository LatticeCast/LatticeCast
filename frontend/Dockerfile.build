# Dockerfile.build
FROM node:24 AS builder
ARG VITE_DEPLOY_COMMIT=unknown
ARG VITE_DEPLOY_ORIGIN
ENV VITE_DEPLOY_COMMIT=${VITE_DEPLOY_COMMIT}
ENV VITE_DEPLOY_ORIGIN=${VITE_DEPLOY_ORIGIN}
WORKDIR /app
COPY . .
RUN npm install
RUN npm run build

FROM scratch AS export
COPY --from=builder /app/build/ /
