#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${TMUX:-}" ]]; then
    echo "[pre-commit] Refusing commit: run git commit inside a tmux session."
    exit 1
fi

echo "[pre-commit] Backend lint"
make lint-be

echo "[pre-commit] Frontend lint"
make lint-fe

echo "[pre-commit] SQL migration lint"
make lint-db

echo "[pre-commit] Fresh-database migration verification"
docker compose --profile migration run --rm --entrypoint python \
    migration migrate.py --test-only

echo "[pre-commit] End-to-end tests"
# The commit gate must always run the complete suite, regardless of any
# focused-test arguments used during development.
make e2e E2E_PYTEST_ARGS='--tb=short -q'

# Include formatter/linter fixes only after every verification succeeds.
echo "[pre-commit] Stage verified changes"
git add .
